# Frontend Environment Variables (.env)
# In Vercel: Add this under Project Settings -> Environment Variables
# In Local Dev: Copy this file as .env inside the frontend/ directory

# Render backend URL (e.g., https://your-backend-service.onrender.com)
# Note: You can provide with or without '/api' - api.js handles both.
VITE_API_URL=https://murali-catalogue-staging.onrender.com
